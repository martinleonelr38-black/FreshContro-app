<PantallaPanelGerente>:
    md_bg_color: 0.96, 0.97, 0.97, 1

    MDBoxLayout:
        orientation: 'vertical'

        # Toolbar / Header Superior
        MDTopAppBar:
            title: "Panel del Gerente"
            elevation: 1
            left_action_items: [["menu", lambda x: getattr(root, 'toggle_nav_drawer', lambda: None)()]]
            right_action_items: [["bell-outline", lambda x: None], ["account-circle-outline", lambda x: None]]
            md_bg_color: 0.08, 0.45, 0.25, 1
            specific_text_color: 1, 1, 1, 1

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(16)
                spacing: dp(16)
                size_hint_y: None
                height: self.minimum_height

                # Banner Bienvenida y Fecha/Hora
                MDCard:
                    orientation: 'horizontal'
                    padding: dp(16)
                    radius: [12,]
                    elevation: 1
                    size_hint_y: None
                    height: dp(80)
                    md_bg_color: 1, 1, 1, 1

                    MDBoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 0.65

                        MDLabel:
                            text: f"¡Bienvenido, {getattr(root, 'nombre_gerente', 'Gerente')}!"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.1, 0.1, 0.1, 1

                        MDLabel:
                            text: "Aquí tienes el resumen general de tu inventario y operaciones."
                            font_style: "Caption"
                            theme_text_color: "Hint"

                    MDBoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 0.35
                        halign: 'right'
                        spacing: dp(4)

                        MDBoxLayout:
                            spacing: dp(4)
                            MDIcon:
                                icon: "calendar"
                                font_size: "16sp"
                                theme_text_color: "Hint"
                            MDLabel:
                                text: getattr(root, 'fecha_actual', '18 de Mayo de 2025')
                                font_style: "Caption"
                                theme_text_color: "Hint"

                        MDBoxLayout:
                            spacing: dp(4)
                            MDIcon:
                                icon: "clock-outline"
                                font_size: "16sp"
                                theme_text_color: "Hint"
                            MDLabel:
                                text: getattr(root, 'hora_actual', '10:24 AM')
                                font_style: "Caption"
                                theme_text_color: "Hint"

                # Cuatro Tarjetas de Métricas en 0
                MDGridLayout:
                    cols: 4
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(110)

                    # Total Productos
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(12)
                        radius: [12,]
                        elevation: 1
                        md_bg_color: 1, 1, 1, 1

                        MDLabel:
                            text: "Total Productos"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.45, 0.25, 1

                        MDBoxLayout:
                            spacing: dp(8)
                            MDIcon:
                                icon: "package-variant-closed"
                                font_size: "32sp"
                                theme_text_color: "Custom"
                                text_color: 0.2, 0.7, 0.3, 1
                            MDLabel:
                                text: str(getattr(root, 'total_productos', 0))
                                font_style: "H4"
                                bold: True

                        MDLabel:
                            text: "+0 este mes"
                            font_style: "Caption"
                            theme_text_color: "Hint"

                    # Stock Bajo
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(12)
                        radius: [12,]
                        elevation: 1
                        md_bg_color: 1, 1, 1, 1

                        MDLabel:
                            text: "Stock Bajo"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.85, 0.45, 0.0, 1

                        MDBoxLayout:
                            spacing: dp(8)
                            MDIcon:
                                icon: "alert-decagram"
                                font_size: "32sp"
                                theme_text_color: "Custom"
                                text_color: 1, 0.6, 0.0, 1
                            MDLabel:
                                text: str(getattr(root, 'stock_bajo', 0))
                                font_style: "H4"
                                bold: True

                        MDLabel:
                            text: "Requieren atención"
                            font_style: "Caption"
                            theme_text_color: "Hint"

                    # Por Vencer
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(12)
                        radius: [12,]
                        elevation: 1
                        md_bg_color: 1, 1, 1, 1

                        MDLabel:
                            text: "Por Vencer"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.1, 0.4, 0.7, 1

                        MDBoxLayout:
                            spacing: dp(8)
                            MDIcon:
                                icon: "calendar-clock"
                                font_size: "32sp"
                                theme_text_color: "Custom"
                                text_color: 0.15, 0.5, 0.8, 1
                            MDLabel:
                                text: str(getattr(root, 'por_vencer', 0))
                                font_style: "H4"
                                bold: True

                        MDLabel:
                            text: "Próximos 7 días"
                            font_style: "Caption"
                            theme_text_color: "Hint"

                    # Vencidos
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(12)
                        radius: [12,]
                        elevation: 1
                        md_bg_color: 1, 1, 1, 1

                        MDLabel:
                            text: "Vencidos"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.1, 0.1, 1

                        MDBoxLayout:
                            spacing: dp(8)
                            MDIcon:
                                icon: "close-circle"
                                font_size: "32sp"
                                theme_text_color: "Custom"
                                text_color: 0.85, 0.2, 0.2, 1
                            MDLabel:
                                text: str(getattr(root, 'vencidos', 0))
                                font_style: "H4"
                                bold: True

                        MDLabel:
                            text: "Requieren acción"
                            font_style: "Caption"
                            theme_text_color: "Hint"

                # Acciones Rápidas del Gerente
                MDLabel:
                    text: "Acciones Rápidas"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                MDGridLayout:
                    cols: 3
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(140)

                    MDRectangleFlatIconButton:
                        icon: "package-variant-closed"
                        text: "Ver Inventario"
                        line_color: 0.9, 0.9, 0.9, 1
                        icon_color: 0.08, 0.45, 0.25, 1
                        size_hint: 1, 1
                        on_release: getattr(root, 'ver_inventario', lambda: None)()

                    MDRectangleFlatIconButton:
                        icon: "plus-box"
                        text: "Agregar Producto"
                        line_color: 0.9, 0.9, 0.9, 1
                        icon_color: 0.08, 0.45, 0.25, 1
                        size_hint: 1, 1
                        on_release: getattr(root, 'agregar_producto', lambda: None)()

                    MDRectangleFlatIconButton:
                        icon: "account-group"
                        text: "Gestionar Empleados"
                        line_color: 0.9, 0.9, 0.9, 1
                        icon_color: 0.08, 0.45, 0.25, 1
                        size_hint: 1, 1
                        on_release: getattr(root, 'gestionar_empleados', lambda: None)()

                    MDRectangleFlatIconButton:
                        icon: "chart-bar"
                        text: "Ver Reportes"
                        line_color: 0.9, 0.9, 0.9, 1
                        icon_color: 0.08, 0.45, 0.25, 1
                        size_hint: 1, 1
                        on_release: getattr(root, 'ver_reportes', lambda: None)()

                    MDRectangleFlatIconButton:
                        icon: "truck-delivery"
                        text: "Gestionar Proveedores"
                        line_color: 0.9, 0.9, 0.9, 1
                        icon_color: 0.08, 0.45, 0.25, 1
                        size_hint: 1, 1
                        on_release: getattr(root, 'gestionar_proveedores', lambda: None)()

                    MDRectangleFlatIconButton:
                        icon: "barcode-scan"
                        text: "Escanear Código"
                        line_color: 0.9, 0.9, 0.9, 1
                        icon_color: 0.08, 0.45, 0.25, 1
                        size_hint: 1, 1
                        on_release: getattr(root, 'escanear_codigo', lambda: None)()

                # Botón de Cierre de Sesión al final
                MDRaisedButton:
                    text: "Cerrar Sesión"
                    icon: "logout"
                    md_bg_color: 0.8, 0.2, 0.2, 1
                    pos_hint: {"center_x": .5}
                    size_hint_x: 1
                    on_release: root.cerrar_sesion()