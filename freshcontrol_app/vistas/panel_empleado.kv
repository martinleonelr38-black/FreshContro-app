                    # PRODUCTOS QUE REQUIEREN ATENCIÓN
                    MDCard:
                        padding: dp(12)
                        radius: [10,]
                        size_hint_y: None
                        height: dp(68)
                        md_bg_color: (0.28, 0.23, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 0.97, 0.92, 1)
                        elevation: 1

                        MDBoxLayout:
                            spacing: dp(12)
                            padding: [0, dp(2), 0, dp(2)]

                            MDIcon:
                                icon: "alert"
                                font_size: "26sp"
                                theme_text_color: "Custom"
                                text_color: 0.9, 0.5, 0.05, 1
                                size_hint_x: None
                                width: dp(26)
                                pos_hint: {"center_y": 0.5}

                            MDBoxLayout:
                                orientation: "vertical"
                                spacing: dp(2)
                                pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    text: "Productos que requieren tu atención"
                                    font_style: "Subtitle2"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.6, 0.3, 0.05, 1

                                MDLabel:
                                    text: "Hay " + str(root.stock_bajo) + " productos con stock bajo y " + str(root.por_vencer) + " por vencer en los próximos 7 días."
                                    font_style: "Caption"

                            MDRaisedButton:
                                text: "Ver detalles"
                                md_bg_color: 0.85, 0.5, 0.05, 1
                                pos_hint: {"center_y": 0.5}
                                on_release: root.ver_inventario()

